# Local development. For compose.production.yaml, use https://your-domain.example.
PUBLIC_URL=http://localhost:3000
SITE_NAME=Newton users
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Use a long random URL-safe password (for example, openssl rand -hex 32).
POSTGRES_PASSWORD=replace-before-production
# compose.production.yaml always sets production mode, regardless of this value.
NODE_ENV=development
# Published image for compose.production.yaml.
USERSMAP_IMAGE=theredhead/usersmap:latest
THEME_PRIMARY=#b2d279
THEME_SURFACE=#182a21
THEME_BACKGROUND=#101c16
THEME_TEXT=#e4ecd8
LOCATION_MINIMUM_KM=1
LOCATION_DEFAULT_KM=5
LOCATION_MAXIMUM_KM=25
POST_INTERVAL_SECONDS=60
MAXIMUM_UPLOAD_BYTES=25000000
MAXIMUM_VIDEO_SECONDS=60
