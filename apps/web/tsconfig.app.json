{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "useDefineForClassFields": false,
    "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "include": ["src/**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
