{
  "name": "newton-users",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "ng serve --host 127.0.0.1",
    "build": "npm run build:web && npm run build:api",
    "build:web": "ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "node dist/api/apps/api/src/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:built": "npm run build:api && TEST_COMPILED_API=1 vitest run --config vitest.integration.config.ts",
    "lint": "eslint apps shared",
    "format": "prettier --write apps shared config *.json *.ts *.mjs *.yaml"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@theredhead/lucid-foundation": "file:vendor/theredhead-lucid-foundation-0.2.1.tgz",
    "@theredhead/lucid-theme": "file:vendor/theredhead-lucid-theme-0.2.1.tgz",
    "@theredhead/lucid-kit": "file:vendor/theredhead-lucid-kit-0.2.1.tgz",
    "@theredhead/lucid-blocks": "file:vendor/theredhead-lucid-blocks-0.2.1.tgz",
    "@theredhead/lucid-forms": "file:vendor/theredhead-lucid-forms-0.2.1.tgz",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "file-type": "^19.6.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.0",
    "tslib": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
